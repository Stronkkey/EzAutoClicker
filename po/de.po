#: src/app_cli_constants.hpp:23
msgid "Automate mouse clicks at fixed intervals."
msgstr "Automatisiere Mausklicks mit festen Abständen."

#: src/app_cli_constants.hpp:24
msgid "Press the configured hotkey (default F5) to start or stop clicking."
msgstr ""
"Drücke die konfigurierte Tastenkombination (Standardwert F5) um den Klicker "
"zu starten/stoppen."

#: src/app_cli_constants.hpp:30
msgid "Start or stop the autoclicker in a running instance."
msgstr "Starte/Stoppe den Klicker in einer laufenden Instanz."

#: src/app_cli_constants.hpp:34
msgid "Click interval in milliseconds."
msgstr "Klickabstand in Millisekunden."

#: src/app_cli_constants.hpp:35
msgid "MILLISECONDS"
msgstr "MILLISEKUNDEN"

#: src/app_cli_constants.hpp:39
msgid "Click interval in seconds."
msgstr "Klickabstand in Sekunden."

#: src/app_cli_constants.hpp:40
msgid "SECONDS"
msgstr "SEKUNDEN"

#: src/app_cli_constants.hpp:44
msgid "Click interval in minutes."
msgstr "Klick Abstand in Minuten."

#: src/app_cli_constants.hpp:45
msgid "MINUTES"
msgstr "MINUTEN"

#: src/app_cli_constants.hpp:49
msgid "Click interval in hours."
msgstr "Klickabstand in Stunden."

#: src/app_cli_constants.hpp:50
msgid "HOURS"
msgstr "STUNDEN"

#: src/app_cli_constants.hpp:54
msgid "Mouse button which is clicked."
msgstr "Maustaste, die gedrückt wird."

#: src/app_cli_constants.hpp:59
msgid ""
"Single (default) sends only one click. Double sends two clicks at the same "
"times."
msgstr ""
"single (Standartwert) schickt nur ein Klick. double schickt zwei Klicks "
"gleichzeitig."

#: src/app_cli_constants.hpp:64
msgid "Send clicks at the current mouse position."
msgstr "Klickt bei der bestehenden Mausposition."

#: src/app_cli_constants.hpp:68
msgid ""
"Send clicks at given screen position. Overrides the use-current-location "
"option."
msgstr ""
"Klickt bei einer angegebenen Bildschirm Koordinate. Hat Vorrang zur use-"
"current-location Flagge."

#: src/app_cli_constants.hpp:69
msgid "X,Y"
msgstr "X,Y"

#: src/app_cli_constants.hpp:73
msgid ""
"Sets Clicker to only stop when manually stopped. Overrides repeat-count "
"argument."
msgstr ""
"Klicker stoppt nur, wenn er manuell gestoppt wird. Hat Vorrang zur repeat-"
"count Flagge."

#: src/app_cli_constants.hpp:77
msgid "Amount of times to repeat before automatically stopping clicker."
msgstr ""
"Wie viele Klicks der Klicker schickt, bevor er automatisch gestoppt wird."

#: src/app_cli_constants.hpp:78
msgid "REPEAT_COUNT"
msgstr "WIEDERHOLUNGS_ANZAHL"

#: src/app_cli_constants.hpp:82
msgid "The clicker backend used to send clicks."
msgstr "Der Backend, der für den Klicker verwendet wird."

#: src/app_cli_constants.hpp:100
msgid "The hotkey listener backend used to listen for the hotkey."
msgstr ""
"Der Backend, der für das erfassen der Tastenkombination verwendet wird."

#: src/app_cli_constants.hpp:110
msgid "Allows running the program as root."
msgstr "Erlaubt das Programm mit root-Rechten zu laufen."

#: src/main.cpp:53
#, c-format
msgid ""
"%s this program cannot be ran as root. Use the --allow-root option to launch "
"as root user anyways. exiting.\n"
msgstr ""
"%s Dieses Programm kann nicht mit root-Rechten ausgeführt werden. Verwende "
"die --allow-root Flagge um trotzdem mit root-Rechten zu starten. Programm "
"wird beendet.\n"

#: src/main.cpp:94
#, c-format
msgid "%s this program cannot be ran as root. exiting.\n"
msgstr ""
"%s Dieses Programm kann nicht als root-Nutzer ausgeführt werden. Programm "
"wird beendet.\n"

#: src/process.cpp:163
msgid ""
"Couldn't find suitable user to drop privileges to. Try running the program "
"with SUDO_UID=$(id -u)."
msgstr ""
"Konnte kein passenden nicht-root-Nutzer finden. Versuche das Programm mit "
"SUDO_UID=$(id -u) zu laufen."

#: src/process.cpp:167
msgid "Failed to find user with the uid "
msgstr "Nutzer mit folgender uid nicht gefunden: "

#: src/process.cpp:171
msgid "Failed to remove supplementary groups."
msgstr "Zusätzliche Gruppen konnten nicht entfernt werden."

#: src/process.cpp:175
msgid "Failed to set gid."
msgstr "Gid konnte nicht gesetzt werden."

#: src/process.cpp:179
msgid "Failed to set uid."
msgstr "Uid konnte nicht gesetzt werden."

#: src/process.cpp:183
msgid "Was able to regain root."
msgstr ""
"Root-rechte konnten trotz Entfernung von root-Rechten wieder hergestellt "
"werden."

#: src/process.cpp:188
msgid "uid/gid mismatch after privilege drop"
msgstr "uid/gid sind nicht gleich nach der Entfernung von root-Rechten"

#: src/window.cpp:354
msgid "Press a key..."
msgstr "Drücke eine Taste..."

